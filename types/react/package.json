{
  "name": "react",
  "version": "18.3.1",
  "main": "./index.js",
  "types": "./index.d.ts",
  "typesVersions": {
    "*": {
      "jsx-runtime": ["./jsx-runtime.d.ts"],
      "jsx-dev-runtime": ["./jsx-dev-runtime.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "default": "./jsx-dev-runtime.js"
    }
  }
}
