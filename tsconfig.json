{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "react": [
        "./node_modules/react/index.d.ts",
        "./types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "./node_modules/react/jsx-runtime.d.ts",
        "./types/react/jsx-runtime.d.ts"
      ],
      "react/jsx-dev-runtime": [
        "./node_modules/react/jsx-dev-runtime.d.ts",
        "./types/react/jsx-dev-runtime.d.ts"
      ],
      "motion/react": [
        "./node_modules/motion/react/index.d.ts",
        "./types/motion/react/index.d.ts"
      ]
    }
  },
  "include": [
    "components/**/*",
    "types/**/*",
    "node_modules/react/*.d.ts",
    "node_modules/motion/react/*.d.ts"
  ]
}